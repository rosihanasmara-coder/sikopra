# Salin file ini menjadi .env untuk development lokal
# Di Railway, isi variabel ini di Settings > Variables

# Wajib di production — ganti dengan string acak panjang
SESSION_SECRET=ganti-dengan-string-rahasia-panjang

# Path database (Railway volume mount path)
# Kosongkan untuk lokal (akan pakai folder db/ otomatis)
VOLUME_PATH=

# Port (Railway mengisi ini otomatis)
PORT=3005
