<%
const barColors = ['#f59e0b','#3b82f6','#10b981','#8b5cf6','#ef4444','#06b6d4','#f97316','#84cc16'];
%>
<%- include('partials/header', { title: 'Pengaturan' }) %>
<%- include('partials/sidebar', { activePage: 'pengaturan' }) %>

<% if (msg) { %>
<div class="alert alert-<%= msgType === 'success' ? 'success' : 'danger' %>"><%= msg %></div>
<% } %>

<!-- Pengaturan Umum -->
<div class="section-card">
  <h2 class="section-title">Pengaturan Sistem</h2>
  <form method="POST" action="/pengaturan/simpan">
    <div class="form-group">
      <label>Nama Koperasi</label>
      <input type="text" name="nama_koperasi" class="form-control" value="<%= param.nama_koperasi || '' %>" required>
    </div>
    <div class="form-group">
      <label>Tahun Aktif</label>
      <input type="number" name="tahun_aktif" class="form-control" value="<%= param.tahun_aktif || new Date().getFullYear() %>" min="2000" max="2099" required>
    </div>
    <div class="form-group">
      <label>Jasa Pinjaman Default (%)</label>
      <input type="number" name="jasa_pinjaman_default" class="form-control" value="<%= param.jasa_pinjaman_default || 5 %>" min="0" max="100" step="0.1" required>
      <small class="form-hint">Persentase jasa pinjaman yang digunakan saat membuat pinjaman baru</small>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">💾 Simpan Pengaturan</button>
    </div>
  </form>
</div>

<!-- Komponen SHU Dinamis -->
<div class="section-card">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
    <h2 class="section-title" style="margin:0">Pembagian Persentase SHU</h2>
    <button class="btn btn-primary btn-sm" onclick="openModal('modalTambahKomponen')">+ Tambah Komponen</button>
  </div>
  <p class="text-muted" style="margin-bottom:1.5rem">
    Kelola alokasi pembagian SHU koperasi secara fleksibel. Tambah, edit, atau hapus komponen sesuai kebutuhan.
    Total seluruh komponen harus <strong>= 100%</strong>.
  </p>

  <!-- Visualisasi Bar -->
  <div class="shu-bar-container" id="shuBar">
    <% komponenShu.forEach((k, i) => { %>
    <div class="shu-bar-seg" id="bar_<%= k.id %>"
      style="width:<%= k.persentase %>%;background:<%= barColors[i % barColors.length] %>">
      <span><%= k.persentase %>%</span>
    </div>
    <% }) %>
  </div>

  <!-- Legend -->
  <div class="shu-legend" id="shuLegend">
    <% komponenShu.forEach((k, i) => { %>
    <span class="legend-item">
      <span class="legend-dot" style="background:<%= barColors[i % barColors.length] %>"></span>
      <%= k.nama %>
    </span>
    <% }) %>
  </div>

  <!-- Status Total -->
  <div class="shu-total-status">
    <span>Total: <strong id="totalNilai"><%= komponenShu.reduce((s,k)=>s+k.persentase,0).toFixed(1) %>%</strong></span>
    <% const totalPersen = komponenShu.reduce((s,k)=>s+k.persentase,0); %>
    <span id="totalBadge" class="badge <%= Math.abs(totalPersen-100)<0.1 ? 'badge-success' : 'badge-danger' %>">
      <%= Math.abs(totalPersen-100)<0.1 ? '✓ Sesuai (100%)' : '✗ Belum 100% (sisa '+(100-totalPersen).toFixed(1)+'%)' %>
    </span>
  </div>

  <!-- Form edit persentase semua sekaligus -->
  <form method="POST" action="/pengaturan/shu-komponen/simpan-semua" id="formShuSemua">
    <div class="komponen-list" id="komponenList">
      <% komponenShu.forEach((k, i) => { %>
      <div class="komponen-item" id="item_<%= k.id %>" data-id="<%= k.id %>">
        <input type="hidden" name="id" value="<%= k.id %>">
        <div class="komponen-color" style="background:<%= barColors[i % barColors.length] %>"></div>
        <div class="komponen-info">
          <div class="komponen-nama"><%= k.nama %></div>
          <div class="komponen-meta">
            <span class="badge badge-<%= k.tipe === 'cadangan' ? 'warning' : k.tipe === 'anggota_peminjam' ? 'primary' : k.tipe === 'anggota_simpanan' ? 'success' : 'info' %>">
              <%= k.tipe === 'cadangan' ? 'Cadangan' : k.tipe === 'anggota_peminjam' ? 'SHU Peminjam' : k.tipe === 'anggota_simpanan' ? 'SHU Simpanan' : 'Umum' %>
            </span>
            <% if (k.deskripsi) { %><span class="text-muted" style="font-size:0.8rem"><%= k.deskripsi %></span><% } %>
          </div>
        </div>
        <div class="komponen-persen-group">
          <input type="number" name="persentase" class="form-control komponen-persen-input"
            value="<%= k.persentase %>" min="0" max="100" step="0.1"
            onchange="hitungTotal()" oninput="hitungTotal()">
          <span class="shu-unit">%</span>
        </div>
        <div class="komponen-aksi">
          <button type="button" class="btn btn-sm btn-warning"
            data-id="<%= k.id %>"
            data-nama="<%= k.nama %>"
            data-persentase="<%= k.persentase %>"
            data-deskripsi="<%= k.deskripsi || '' %>"
            data-tipe="<%= k.tipe %>"
            onclick="editKomponen(this)">Edit</button>
          <% if (komponenShu.length > 1) { %>
          <form method="POST" action="/pengaturan/shu-komponen/hapus" style="display:inline"
            onsubmit="return confirm('Hapus komponen <%= k.nama %>?')">
            <input type="hidden" name="id" value="<%= k.id %>">
            <button class="btn btn-sm btn-danger" type="submit">Hapus</button>
          </form>
          <% } %>
        </div>
      </div>
      <% }) %>
    </div>

    <!-- Total bar bawah -->
    <div class="komponen-total-row">
      <div style="font-weight:700;color:#374151">Total</div>
      <div style="display:flex;align-items:center;gap:0.75rem">
        <span style="font-size:1.3rem;font-weight:800;color:#1f2937" id="totalBawah">
          <%= komponenShu.reduce((s,k)=>s+k.persentase,0).toFixed(1) %>%
        </span>
        <span id="totalBawahBadge" class="badge <%= Math.abs(totalPersen-100)<0.1 ? 'badge-success' : 'badge-danger' %>">
          <%= Math.abs(totalPersen-100)<0.1 ? '✓ OK' : '✗ Belum 100%' %>
        </span>
      </div>
      <div></div>
      <div>
        <button type="submit" class="btn btn-primary" id="btnSimpanSemua">💾 Simpan Persentase</button>
        <button type="button" class="btn btn-secondary" onclick="resetDefault()">↺ Reset Default</button>
      </div>
    </div>
  </form>

  <!-- Tabel Ringkasan -->
  <div style="margin-top:1.5rem">
    <h3 style="font-size:0.95rem;font-weight:600;color:#374151;margin-bottom:0.75rem">Ringkasan Rumus SHU</h3>
    <table class="detail-table">
      <tr><th>Komponen</th><th>Tipe</th><th style="text-align:right">Persentase</th><th>Keterangan Distribusi</th></tr>
      <% komponenShu.forEach(k => { %>
      <tr>
        <td><strong><%= k.nama %></strong></td>
        <td><span class="badge badge-<%= k.tipe==='cadangan'?'warning':k.tipe==='anggota_peminjam'?'primary':k.tipe==='anggota_simpanan'?'success':'info' %>">
          <%= k.tipe==='cadangan'?'Cadangan':k.tipe==='anggota_peminjam'?'SHU Peminjam':k.tipe==='anggota_simpanan'?'SHU Simpanan':'Umum' %>
        </span></td>
        <td style="text-align:right"><strong><%= k.persentase %>%</strong></td>
        <td style="font-size:0.82rem;color:#6b7280">
          <% if (k.tipe==='cadangan') { %>Masuk kas koperasi, tidak dibagi ke anggota
          <% } else if (k.tipe==='anggota_peminjam') { %>Dibagi proporsional: (Jasa pinjaman anggota ÷ Total jasa pinjaman) × <%= k.persentase %>%
          <% } else if (k.tipe==='anggota_simpanan') { %>Dibagi proporsional: (Simpanan anggota ÷ Total simpanan) × <%= k.persentase %>%
          <% } else { %>Komponen umum — tidak otomatis didistribusikan ke anggota
          <% } %>
        </td>
      </tr>
      <% }) %>
      <tr style="background:#f0fdf4;font-weight:700">
        <td colspan="2">Total</td>
        <td style="text-align:right"><%= komponenShu.reduce((s,k)=>s+k.persentase,0).toFixed(1) %>%</td>
        <td>Harus = 100%</td>
      </tr>
    </table>
  </div>
</div>

<!-- Informasi Sistem -->
<div class="section-card">
  <h2 class="section-title">Informasi Sistem</h2>
  <table class="detail-table">
    <tr><th>Versi Aplikasi</th><td>1.0.0</td></tr>
    <tr><th>Database</th><td>SQLite (node:sqlite)</td></tr>
    <tr><th>Framework</th><td>Node.js + Express.js</td></tr>
    <tr><th>Template Engine</th><td>EJS</td></tr>
  </table>
</div>

<!-- Modal Tambah Komponen -->
<div class="modal-overlay" id="modalTambahKomponen">
  <div class="modal">
    <div class="modal-header">
      <h3>Tambah Komponen SHU</h3>
      <button class="modal-close" onclick="closeModal('modalTambahKomponen')">&times;</button>
    </div>
    <form method="POST" action="/pengaturan/shu-komponen/tambah">
      <div class="modal-body">
        <div class="form-group">
          <label>Nama Komponen <span class="required">*</span></label>
          <input type="text" name="nama" class="form-control" placeholder="contoh: Dana Sosial" required>
        </div>
        <div class="form-group">
          <label>Kode Unik <span class="required">*</span></label>
          <input type="text" name="kode" id="inputKode" class="form-control" placeholder="contoh: dana_sosial" required
            pattern="[a-zA-Z0-9_]+" title="Hanya huruf, angka, dan underscore">
          <small class="form-hint">Hanya huruf kecil, angka, dan underscore. Tidak bisa diubah setelah disimpan.</small>
        </div>
        <div class="form-group">
          <label>Persentase (%) <span class="required">*</span></label>
          <input type="number" name="persentase" class="form-control" min="0" max="100" step="0.1" value="0" required>
        </div>
        <div class="form-group">
          <label>Tipe Distribusi <span class="required">*</span></label>
          <select name="tipe" class="form-control">
            <option value="cadangan">Cadangan — masuk kas, tidak dibagi anggota</option>
            <option value="anggota_peminjam">SHU Peminjam — dibagi proporsional jasa pinjaman</option>
            <option value="anggota_simpanan">SHU Simpanan — dibagi proporsional simpanan</option>
            <option value="umum">Umum — dicatat tapi tidak otomatis dibagi</option>
          </select>
        </div>
        <div class="form-group">
          <label>Deskripsi</label>
          <input type="text" name="deskripsi" class="form-control" placeholder="Keterangan singkat komponen ini">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('modalTambahKomponen')">Batal</button>
        <button type="submit" class="btn btn-primary">Tambah</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit Komponen -->
<div class="modal-overlay" id="modalEditKomponen">
  <div class="modal">
    <div class="modal-header">
      <h3>Edit Komponen SHU</h3>
      <button class="modal-close" onclick="closeModal('modalEditKomponen')">&times;</button>
    </div>
    <form method="POST" action="/pengaturan/shu-komponen/edit">
      <input type="hidden" name="id" id="editKomponenId">
      <div class="modal-body">
        <div class="form-group">
          <label>Nama Komponen <span class="required">*</span></label>
          <input type="text" name="nama" id="editKomponenNama" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Persentase (%)</label>
          <input type="number" name="persentase" id="editKomponenPersen" class="form-control" min="0" max="100" step="0.1" required>
        </div>
        <div class="form-group">
          <label>Tipe Distribusi</label>
          <select name="tipe" id="editKomponenTipe" class="form-control">
            <option value="cadangan">Cadangan — masuk kas, tidak dibagi anggota</option>
            <option value="anggota_peminjam">SHU Peminjam — dibagi proporsional jasa pinjaman</option>
            <option value="anggota_simpanan">SHU Simpanan — dibagi proporsional simpanan</option>
            <option value="umum">Umum — dicatat tapi tidak otomatis dibagi</option>
          </select>
        </div>
        <div class="form-group">
          <label>Deskripsi</label>
          <input type="text" name="deskripsi" id="editKomponenDesk" class="form-control">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('modalEditKomponen')">Batal</button>
        <button type="submit" class="btn btn-primary">Simpan</button>
      </div>
    </form>
  </div>
</div>

<style>
.shu-bar-container {
  display: flex; height: 44px; border-radius: 10px;
  overflow: hidden; margin-bottom: 0.6rem;
  border: 1px solid #e5e7eb;
}
.shu-bar-seg {
  display: flex; align-items: center; justify-content: center;
  font-size: 0.78rem; font-weight: 700; color: #fff;
  transition: width 0.35s ease; min-width: 0; overflow: hidden;
}
.shu-legend { display: flex; gap: 1.2rem; margin-bottom: 1rem; flex-wrap: wrap; }
.legend-item { display: flex; align-items: center; gap: 0.35rem; font-size: 0.82rem; color: #6b7280; }
.legend-dot { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }
.shu-total-status {
  display: flex; align-items: center; gap: 1rem;
  padding: 0.65rem 1rem; background: #f9fafb;
  border-radius: 8px; margin-bottom: 1.5rem;
  border: 1px solid #e5e7eb; font-size: 0.9rem;
}
.komponen-list { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1rem; }
.komponen-item {
  display: grid;
  grid-template-columns: 6px 1fr auto auto;
  gap: 0.75rem; align-items: center;
  padding: 0.75rem 1rem;
  background: #f9fafb; border: 1px solid #e5e7eb;
  border-radius: 10px; transition: box-shadow 0.2s;
}
.komponen-item:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.07); }
.komponen-color { width: 6px; height: 44px; border-radius: 4px; }
.komponen-nama { font-weight: 600; color: #1f2937; font-size: 0.95rem; }
.komponen-meta { display: flex; gap: 0.5rem; align-items: center; margin-top: 0.2rem; flex-wrap: wrap; }
.komponen-persen-group { display: flex; align-items: center; gap: 0.4rem; }
.komponen-persen-input {
  width: 90px; font-size: 1.1rem; font-weight: 700;
  text-align: center; padding: 0.4rem;
}
.shu-unit { font-size: 1rem; font-weight: 600; color: #6b7280; }
.komponen-aksi { display: flex; gap: 0.4rem; align-items: center; }
.komponen-total-row {
  display: grid; grid-template-columns: 6px 1fr auto auto;
  gap: 0.75rem; align-items: center;
  padding: 0.75rem 1rem;
  background: #f0fdf4; border: 2px solid #bbf7d0;
  border-radius: 10px; margin-top: 0.5rem;
}
</style>

<script>
const BAR_COLORS = ['#f59e0b','#3b82f6','#10b981','#8b5cf6','#ef4444','#06b6d4','#f97316','#84cc16'];

function hitungTotal() {
  const inputs = document.querySelectorAll('.komponen-persen-input');
  let total = 0;
  inputs.forEach(inp => total += parseFloat(inp.value) || 0);

  // Update bar
  const segs = document.querySelectorAll('.shu-bar-seg');
  inputs.forEach((inp, i) => {
    if (segs[i]) {
      segs[i].style.width = (inp.value || 0) + '%';
      segs[i].querySelector('span').textContent = (parseFloat(inp.value)||0) + '%';
    }
  });

  const ok = Math.abs(total - 100) < 0.1;
  document.getElementById('totalNilai').textContent = total.toFixed(1) + '%';
  document.getElementById('totalBawah').textContent = total.toFixed(1) + '%';

  const badge = document.getElementById('totalBadge');
  const badge2 = document.getElementById('totalBawahBadge');
  badge.textContent = ok ? '✓ Sesuai (100%)' : '✗ Belum 100% (sisa '+(100-total).toFixed(1)+'%)';
  badge.className = 'badge ' + (ok ? 'badge-success' : 'badge-danger');
  badge2.textContent = ok ? '✓ OK' : '✗ Belum 100%';
  badge2.className = 'badge ' + (ok ? 'badge-success' : 'badge-danger');

  document.getElementById('btnSimpanSemua').disabled = !ok;
}

function editKomponen(btn) {
  document.getElementById('editKomponenId').value = btn.dataset.id;
  document.getElementById('editKomponenNama').value = btn.dataset.nama;
  document.getElementById('editKomponenPersen').value = btn.dataset.persentase;
  document.getElementById('editKomponenTipe').value = btn.dataset.tipe;
  document.getElementById('editKomponenDesk').value = btn.dataset.deskripsi;
  openModal('modalEditKomponen');
}

function resetDefault() {
  if (!confirm('Reset ke nilai default (Cadangan 2%, Peminjam 59%, Simpanan 39%)?\nKomponen tambahan tidak akan dihapus, hanya persentase direset ke 0.')) return;
  const inputs = document.querySelectorAll('.komponen-persen-input');
  inputs.forEach(inp => inp.value = 0);
  hitungTotal();
}

// Auto-generate kode dari nama
const namaInput = document.querySelector('[name="nama"]');
if (namaInput) {
  namaInput.addEventListener('input', function() {
    const kodeEl = document.getElementById('inputKode');
    if (kodeEl && !kodeEl.dataset.edited) {
      kodeEl.value = this.value.toLowerCase().replace(/\s+/g,'_').replace(/[^a-z0-9_]/g,'');
    }
  });
}
const kodeEl = document.getElementById('inputKode');
if (kodeEl) kodeEl.addEventListener('input', function() { this.dataset.edited = '1'; });

document.getElementById('formShuSemua').addEventListener('submit', function(e) {
  const inputs = document.querySelectorAll('.komponen-persen-input');
  let total = 0;
  inputs.forEach(inp => total += parseFloat(inp.value)||0);
  if (Math.abs(total-100) >= 0.1) {
    e.preventDefault();
    alert('Total persentase harus 100%. Saat ini: ' + total.toFixed(1) + '%');
  }
});

hitungTotal();
</script>

<%- include('partials/footer') %>
