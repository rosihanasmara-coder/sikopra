<%- include('partials/header', { title: 'Tahun Buku' }) %>
<%- include('partials/sidebar', { activePage: 'tahunBuku' }) %>

<div class="page-actions">
  <button class="btn btn-primary" onclick="openModal('modalTambah')">+ Tambah Tahun Buku</button>
</div>

<div class="section-card">
  <h2 class="section-title">Daftar Tahun Buku</h2>
  <div class="table-wrapper">
    <table class="data-table">
      <thead>
        <tr><th>Tahun</th><th>Status</th><th>Tanggal Dikunci</th><th>Keterangan</th><th>Aksi</th></tr>
      </thead>
      <tbody>
        <% tahunList.forEach(t => { %>
        <tr>
          <td><strong><%= t.tahun %></strong></td>
          <td>
            <% if (t.status === 'terkunci') { %>
            <span class="badge badge-danger">🔒 Terkunci</span>
            <% } else { %>
            <span class="badge badge-success">✅ Aktif</span>
            <% } %>
          </td>
          <td><%= t.tanggal_kunci || '-' %></td>
          <td><%= t.keterangan || '-' %></td>
          <td>
            <% if (t.status !== 'terkunci') { %>
            <form method="POST" action="/tahun-buku/kunci" style="display:inline"
              onsubmit="return confirm('Kunci tahun buku <%= t.tahun %>? Data yang terkunci tidak dapat diubah!')">
              <input type="hidden" name="id" value="<%= t.id %>">
              <button class="btn btn-sm btn-warning" type="submit">🔒 Kunci</button>
            </form>
            <% } else { %>
            <form method="POST" action="/tahun-buku/buka" style="display:inline"
              onsubmit="return confirm('Buka kunci tahun buku <%= t.tahun %>?')">
              <input type="hidden" name="id" value="<%= t.id %>">
              <button class="btn btn-sm btn-secondary" type="submit">🔓 Buka Kunci</button>
            </form>
            <% } %>
            <form method="POST" action="/tahun-buku/hapus" style="display:inline"
              onsubmit="return confirm('Hapus tahun buku ini? Pastikan tidak ada transaksi.')">
              <input type="hidden" name="id" value="<%= t.id %>">
              <button class="btn btn-sm btn-danger" type="submit">Hapus</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="text-muted" style="margin-top:8px;font-size:13px;">
    ⚠️ Tahun buku yang terkunci tidak dapat diubah. Data simpanan dan pinjaman pada tahun tersebut tidak dapat ditambah, diedit, atau dihapus.
  </p>
</div>

<!-- Modal Tambah -->
<div class="modal-overlay" id="modalTambah">
  <div class="modal">
    <div class="modal-header">
      <h3>Tambah Tahun Buku</h3>
      <button class="modal-close" onclick="closeModal('modalTambah')">&times;</button>
    </div>
    <form method="POST" action="/tahun-buku/tambah">
      <div class="modal-body">
        <div class="form-group">
          <label>Tahun <span class="required">*</span></label>
          <input type="number" name="tahun" required min="2000" max="2099" class="form-control" value="<%= new Date().getFullYear() %>">
        </div>
        <div class="form-group">
          <label>Keterangan</label>
          <input type="text" name="keterangan" class="form-control">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal('modalTambah')">Batal</button>
        <button type="submit" class="btn btn-primary">Simpan</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
