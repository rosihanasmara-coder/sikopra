<%- include('partials/header', { title: 'Rekonsiliasi' }) %>
<%- include('partials/sidebar', { activePage: 'rekonsiliasi' }) %>

<div class="section-card">
  <h2 class="section-title">Status Rekonsiliasi</h2>
  <p class="text-muted">Pemeriksaan kesesuaian data transaksi koperasi</p>

  <div class="rekon-list">
    <% checks.forEach(c => { %>
    <div class="rekon-item rekon-<%= c.status %>">
      <div class="rekon-icon"><%= c.status === 'ok' ? '✅' : '❌' %></div>
      <div class="rekon-content">
        <div class="rekon-title"><%= c.title %></div>
        <div class="rekon-detail"><%= c.detail %></div>
      </div>
      <div class="rekon-badge badge badge-<%= c.status === 'ok' ? 'success' : 'danger' %>">
        <%= c.status === 'ok' ? 'Sesuai' : 'Tidak Sesuai' %>
      </div>
    </div>
    <% }) %>
  </div>

  <% const allOk = checks.every(c => c.status === 'ok'); %>
  <div class="rekon-summary <%= allOk ? 'summary-ok' : 'summary-error' %>">
    <% if (allOk) { %>
    <strong>✅ Semua data dalam kondisi sesuai. Rekonsiliasi berhasil.</strong>
    <% } else { %>
    <strong>⚠️ Terdapat <%= checks.filter(c => c.status !== 'ok').length %> masalah yang perlu ditangani.</strong>
    <% } %>
  </div>
</div>

<!-- Detail Saldo Negatif jika ada -->
<% if (saldoNegatif && saldoNegatif.length > 0) { %>
<div class="section-card">
  <h2 class="section-title text-danger">Anggota dengan Saldo Pinjaman Negatif</h2>
  <div class="table-wrapper">
    <table class="data-table">
      <thead>
        <tr><th>Anggota</th><th class="text-right">Total Pinjaman</th><th class="text-right">Total Angsuran</th><th class="text-right">Saldo</th></tr>
      </thead>
      <tbody>
        <% saldoNegatif.forEach(s => { %>
        <tr>
          <td><%= s.nomor_anggota %> - <%= s.nama %></td>
          <td class="text-right">Rp <%= s.total_pinjaman.toLocaleString('id-ID') %></td>
          <td class="text-right">Rp <%= s.total_angsuran.toLocaleString('id-ID') %></td>
          <td class="text-right text-danger">Rp <%= s.saldo.toLocaleString('id-ID') %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<%- include('partials/footer') %>
