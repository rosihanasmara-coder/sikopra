<%- include('partials/header', { title: 'SHU' }) %>
<%- include('partials/sidebar', { activePage: 'shu' }) %>

<!-- Filter tahun -->
<div class="section-card">
  <form method="GET" action="/shu" class="filter-form">
    <div class="filter-row">
      <div class="form-group">
        <label>Filter Tahun Buku</label>
        <select name="tahun" class="form-control">
          <option value="">-- Semua Tahun --</option>
          <% tahunList.forEach(t => { %>
          <option value="<%= t.tahun %>" <%= filterTahun == t.tahun ? 'selected' : '' %>><%= t.tahun %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group align-end">
        <button type="submit" class="btn btn-primary">Hitung SHU</button>
        <a href="/shu" class="btn btn-secondary">Reset</a>
      </div>
    </div>
  </form>
</div>

<!-- SHU Summary -->
<div class="cards-grid">
  <div class="card card-primary">
    <div class="card-body">
      <div class="card-label">Total Jasa Pinjaman (SHU Koperasi)</div>
      <div class="card-value">Rp <%= shuKoperasi.toLocaleString('id-ID') %></div>
    </div>
  </div>
  <div class="card card-warning">
    <div class="card-body">
      <div class="card-label">Cadangan (<%= persen.cadangan %>%)</div>
      <div class="card-value">Rp <%= cadangan.toLocaleString('id-ID') %></div>
    </div>
  </div>
  <div class="card card-success">
    <div class="card-body">
      <div class="card-label">SHU Dibagi Anggota (98%)</div>
      <div class="card-value">Rp <%= shuDibagi.toLocaleString('id-ID') %></div>
    </div>
  </div>
  <div class="card card-info">
    <div class="card-body">
      <div class="card-label">Total Simpanan Semua Anggota</div>
      <div class="card-value">Rp <%= totalSimpananSemua.toLocaleString('id-ID') %></div>
    </div>
  </div>
</div>

<div class="cards-grid">
  <div class="card">
    <div class="card-body">
      <div class="card-label">Porsi Peminjam (<%= persen.peminjam %>%) dari SHU Dibagi</div>
      <div class="card-value text-primary">Rp <%= porsiPeminjam.toLocaleString('id-ID') %></div>
    </div>
  </div>
  <div class="card">
    <div class="card-body">
      <div class="card-label">Porsi Simpanan (<%= persen.simpanan %>%) dari SHU Dibagi</div>
      <div class="card-value text-success">Rp <%= porsiSimpanan.toLocaleString('id-ID') %></div>
    </div>
  </div>
</div>

<!-- Tabel SHU per Anggota -->
<div class="section-card">
  <h2 class="section-title">Rincian SHU per Anggota</h2>
  <div class="table-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th>Anggota</th>
          <th class="text-right">Jasa Pinjaman</th>
          <th class="text-right">Total Simpanan</th>
          <th class="text-right">SHU dari Pinjaman</th>
          <th class="text-right">SHU dari Simpanan</th>
          <th class="text-right">Total SHU</th>
        </tr>
      </thead>
      <tbody>
        <% let grandTotal = 0; %>
        <% shuAnggota.forEach(s => { %>
        <% grandTotal += s.total_shu; %>
        <tr>
          <td><%= s.nomor_anggota %> - <%= s.nama %></td>
          <td class="text-right">Rp <%= s.jasa_pinjaman.toLocaleString('id-ID') %></td>
          <td class="text-right">Rp <%= s.total_simpanan.toLocaleString('id-ID') %></td>
          <td class="text-right">Rp <%= Math.round(s.shu_pinjaman).toLocaleString('id-ID') %></td>
          <td class="text-right">Rp <%= Math.round(s.shu_simpanan).toLocaleString('id-ID') %></td>
          <td class="text-right"><strong>Rp <%= Math.round(s.total_shu).toLocaleString('id-ID') %></strong></td>
        </tr>
        <% }) %>
        <% if (shuAnggota.length === 0) { %>
        <tr><td colspan="6" class="text-center text-muted">Belum ada data</td></tr>
        <% } %>
      </tbody>
      <tfoot>
        <tr class="table-total">
          <td colspan="3"><strong>Total SHU Dibagi</strong></td>
          <td colspan="3" class="text-right"><strong>Rp <%= Math.round(grandTotal).toLocaleString('id-ID') %></strong></td>
        </tr>
      </tfoot>
    </table>
  </div>
  <p class="text-muted" style="margin-top:8px;font-size:13px;">
    * SHU dari pinjaman = (Jasa pinjaman anggota / Total jasa pinjaman) × <%= persen.peminjam %>% × SHU Koperasi<br>
    * SHU dari simpanan = (Total simpanan anggota / Total simpanan semua) × <%= persen.simpanan %>% × SHU Koperasi
  </p>
</div>

<%- include('partials/footer') %>
