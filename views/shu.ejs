<%- include('partials/header', { title: 'SHU' }) %>
<%- include('partials/sidebar', { activePage: 'shu' }) %>

<!-- Filter tahun -->
<div class="section-card">
  <form method="GET" action="/shu" class="filter-form">
    <div class="filter-row">
      <div class="form-group">
        <label>Filter Tahun Buku</label>
        <select name="tahun" class="form-control">
          <option value="">-- Semua Tahun --</option>
          <% tahunList.forEach(t => { %>
          <option value="<%= t.tahun %>" <%= filterTahun == t.tahun ? 'selected' : '' %>><%= t.tahun %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group align-end">
        <button type="submit" class="btn btn-primary">Hitung SHU</button>
        <a href="/shu" class="btn btn-secondary">Reset</a>
      </div>
    </div>
  </form>
</div>

<!-- Kartu Ringkasan -->
<div class="cards-grid">
  <div class="card card-primary">
    <div class="card-body">
      <div class="card-label">Total Jasa Pinjaman (Basis SHU)</div>
      <div class="card-value">Rp <%= shuKoperasi.toLocaleString('id-ID') %></div>
    </div>
  </div>
  <div class="card card-warning">
    <div class="card-body">
      <div class="card-label">Total Cadangan / KAS</div>
      <div class="card-value">Rp <%= Math.round(cadangan).toLocaleString('id-ID') %></div>
    </div>
  </div>
  <div class="card card-success">
    <div class="card-body">
      <div class="card-label">Total SHU Dibagi ke Anggota</div>
      <div class="card-value">Rp <%= Math.round(shuDibagi).toLocaleString('id-ID') %></div>
    </div>
  </div>
  <div class="card card-info">
    <div class="card-body">
      <div class="card-label">Total Simpanan Semua Anggota</div>
      <div class="card-value">Rp <%= totalSimpananSemua.toLocaleString('id-ID') %></div>
    </div>
  </div>
</div>

<!-- Rincian Komponen SHU -->
<div class="section-card">
  <h2 class="section-title">Rincian Komponen SHU Koperasi</h2>
  <div class="cards-grid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))">
    <% const barColors = ['#f59e0b','#3b82f6','#10b981','#8b5cf6','#ef4444','#06b6d4','#f97316','#84cc16']; %>
    <% komponenHasil.forEach((k, i) => { %>
    <div class="card" style="border-top:4px solid <%= barColors[i % barColors.length] %>">
      <div class="card-body">
        <div class="card-label"><%= k.nama %> (<%= k.persentase %>%)</div>
        <div class="card-value" style="color:<%= barColors[i % barColors.length] %>">
          Rp <%= Math.round(k.nominal).toLocaleString('id-ID') %>
        </div>
        <div style="margin-top:0.3rem">
          <span class="badge badge-<%= k.tipe==='cadangan'?'warning':k.tipe==='anggota_peminjam'?'primary':k.tipe==='anggota_simpanan'?'success':'info' %>" style="font-size:0.72rem">
            <%= k.tipe==='cadangan'?'Cadangan':k.tipe==='anggota_peminjam'?'SHU Peminjam':k.tipe==='anggota_simpanan'?'SHU Simpanan':'Umum' %>
          </span>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
</div>

<!-- Tabel SHU per Anggota -->
<div class="section-card">
  <h2 class="section-title">Rincian SHU per Anggota</h2>
  <div class="table-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th>No</th>
          <th>Anggota</th>
          <th class="text-right">Jasa Pinjaman</th>
          <th class="text-right">Total Simpanan</th>
          <% kompPeminjam.forEach(k => { %>
          <th class="text-right"><%= k.nama %></th>
          <% }) %>
          <% kompSimpanan.forEach(k => { %>
          <th class="text-right"><%= k.nama %></th>
          <% }) %>
          <th class="text-right">Total SHU</th>
        </tr>
      </thead>
      <tbody>
        <% let grandTotal = 0; %>
        <% shuAnggota.forEach((s, i) => { %>
        <% grandTotal += s.total_shu; %>
        <tr>
          <td><%= i+1 %></td>
          <td><%= s.nomor_anggota %> - <%= s.nama %></td>
          <td class="text-right">Rp <%= s.jasa_pinjaman.toLocaleString('id-ID') %></td>
          <td class="text-right">Rp <%= s.total_simpanan.toLocaleString('id-ID') %></td>
          <% kompPeminjam.forEach(() => { %>
          <td class="text-right">Rp <%= Math.round(s.shu_pinjaman / (kompPeminjam.length||1)).toLocaleString('id-ID') %></td>
          <% }) %>
          <% kompSimpanan.forEach(() => { %>
          <td class="text-right">Rp <%= Math.round(s.shu_simpanan / (kompSimpanan.length||1)).toLocaleString('id-ID') %></td>
          <% }) %>
          <td class="text-right"><strong>Rp <%= Math.round(s.total_shu).toLocaleString('id-ID') %></strong></td>
        </tr>
        <% }) %>
        <% if (shuAnggota.length === 0) { %>
        <tr><td colspan="10" class="text-center text-muted">Belum ada data</td></tr>
        <% } %>
      </tbody>
      <tfoot>
        <tr class="table-total">
          <td colspan="4"><strong>Total SHU Dibagi ke Anggota</strong></td>
          <td colspan="<%= kompPeminjam.length + kompSimpanan.length + 1 %>" class="text-right">
            <strong>Rp <%= Math.round(grandTotal).toLocaleString('id-ID') %></strong>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="text-muted" style="margin-top:0.75rem;font-size:0.8rem;line-height:1.6">
    <% kompPeminjam.forEach(k => { %>
    * <strong><%= k.nama %></strong>: (Jasa pinjaman anggota ÷ Total jasa pinjaman) × <%= k.persentase %>% × SHU Koperasi<br>
    <% }) %>
    <% kompSimpanan.forEach(k => { %>
    * <strong><%= k.nama %></strong>: (Simpanan anggota ÷ Total simpanan semua) × <%= k.persentase %>% × SHU Koperasi<br>
    <% }) %>
    <a href="/pengaturan" class="text-primary" style="font-size:0.82rem">⚙ Ubah komponen SHU di Pengaturan</a>
  </div>
</div>

<%- include('partials/footer') %>
